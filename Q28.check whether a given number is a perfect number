#include <stdio.h>

int main() {
    int num, i, sum = 0;

    printf("Enter a positive integer: ");
    scanf("%d", &num);

    // Loop to find factors up to half of the number
    for (i = 1; i <= num / 2; i++) {
        if (num % i == 0) {
            sum += i; // Add the factor to the sum
        }
    }

    // Check if the sum of factors equals the original number
    if (sum == num && num > 0) {
        printf("%d is a perfect number.\n", num);
    } else {
        printf("%d is not a perfect number.\n", num);
    }

    return 0;
}
