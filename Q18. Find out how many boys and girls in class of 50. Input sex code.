#include <stdio.h>

int main(){
    int i, boys=0, girls=0;
    char sex;

    printf("Enter sex code (B for Boy, G for Girl) for 50 students:\n");
    for(i=1; i<=50; i++){
        printf("Student %d: ", i);
        scanf(" %c", &sex); // space before %c is important

        if(sex=='B' || sex=='b')
            boys++;
        else if(sex=='G' || sex=='g')
            girls++;
    }

    printf("\nTotal Boys = %d\n", boys);
    printf("Total Girls = %d", girls);
    return 0;
}
