#include <stdio.h>

int main(){
    int n, r, sum=0, original;
    printf("Enter number: ");
    scanf("%d", &n);
    
    original = n;
    
    while(n > 0){
        r = n % 10;
        sum = sum + (r*r*r);
        n = n / 10;
    }
    
    if(original == sum){
        printf("Armstrong number");
    } else {
        printf("Not Armstrong number");
    }
    return 0;
}
