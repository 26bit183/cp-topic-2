#include <stdio.h>

int main(){
    int n, d;
    printf("Enter number: ");
    scanf("%d",&n);

    while(n>0){
        d = n % 10;
        if(d==0) printf("Zero ");
        if(d==1) printf("One ");
        if(d==2) printf("Two ");
        if(d==3) printf("Three ");
        if(d==4) printf("Four ");
        if(d==5) printf("Five ");
        if(d==6) printf("Six ");
        if(d==7) printf("Seven ");
        if(d==8) printf("Eight ");
        if(d==9) printf("Nine ");
        n = n/10;
    }
    return 0;
}
